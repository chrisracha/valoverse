</head>
<body>
    <nav>
        <img src="images/logo.png" />
        <ul>
            <li><a href="javascript:void(0);" onclick="smoothScroll('#agents')">Agents</a></li>
            <li><a href="javascript:void(0);" onclick="smoothScroll('#account')">Account</a></li>
            <li><a href="javascript:void(0);" onclick="smoothScroll('#about')">About</a></li>
        </ul>
    </nav>
    <div class="banner">
        <img src="images/banner.jpg" />
        <div class="banner-text">
            <h1 id="agents">AGENTS</h1>
        </div>
    </div>
    <main>
        <div class="agents" id="agents">
            <div class="agent_list"><ul style="padding: 30px;"><a href="#" onclick="event.preventDefault();loadAgentStats('1')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('2')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('3')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('4')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('5')"><img src="data:image/png;base64,"/></a><br><a href="#" onclick="event.preventDefault();loadAgentStats('6')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('7')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('8')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('9')"><img src="data:image/png;base64,"/></a><a href="#" onclick="event.preventDefault();loadAgentStats('10')"><img src="data:image/png;base64,"/></a><br></ul>
<form action="" method="GET">
        <input type="text" name="search" placeholder="SEARCH AGENTS / LEAVE BLANK TO DISPLAY ALL">
        <label>
            <input type="checkbox" name="role[]" value="initiator">
            Initiator
        </label>
        <label>
            <input type="checkbox" name="role[]" value="sentinel">
            Sentinel
        </label>
        <label>
            <input type="checkbox" name="role[]" value="duelist">
            Duelist
        </label>
        <label>
            <input type="checkbox" name="role[]" value="controller">
            Controller
        </label>
        <br>
        <button type="submit">Search</button>
</form>
</div>
            <div class="agent_stats"><div class="agent_preview"><div class="agent_preview_image"><img src="data:image/png;base64,"/></div><div class="agent_preview_text"><h2 .class="agents_header"> // 003</h2><h1 class="agents_header">Jett</h1><h3 class="agents_header">Joon-Hee //  South Korea</h3><h4 class="agents_header">Representing her home country of South Korea, Jett's agile and evasive fighting style lets her take risks no one else can. She runs circles around every skirmish, cutting enemies before they even know what hit them.</h4><div  class="agent_role_icon"><img src="images/roleicons/Duelist.png" /></div><h5 class="agents_header">Abilities</h5><h2 class="agents_header">Cloudburst</h2><h2 class="agents_header">Updraft</h2><h2 class="agents_header"></h2><h2 class="agents_header">Tailwind</h2><h6 style="margin: 40px 0 10px; line-height: 20px;" class="agents_header">Blade Storm</h6><h5 class="agents_header">Ultimate</h5><h2 class="agents_header">♦♦♦♦♦♦♦</h2></div></div></div>
        </div>
        <div class="accounts" id="account"><div class="account_form" id="loginSection"><form class="accounts_header" id="loginForm" method="post" action="index.php"><h1>Log In</h1><input type="text" name="username" placeholder="USERNAME" required><input type="password" name="password" placeholder="PASSWORD" required><input type="submit" value="Log In" name="login"></form><p id="signupLink" class="accounts_header">Don't have an account? Sign up <a href="#" id="signupTrigger" class="form-a">here</a></p></div></div>
        </div>
    </main>
    <footer id="about">
        <img src="images/logo.png" />
